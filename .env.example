# Nexus AI configuration. Copy to .env and fill in.
# .env is gitignored. Never commit it.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Gemini (required) ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Was hardcoded as "gemini-pro" in four places; that alias is retired.
GEMINI_MODEL=gemini-2.5-flash

# --- Notion (required) ---------------------------------------------------
# https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Google OAuth (optional; Gmail and Calendar are unavailable without it)
# Download the OAuth client from the Google Cloud console and save it at the
# path below, then run:  python -m src.main --authorize
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_TOKEN_PATH=credentials/token.json

# How far ahead calendar_list looks. 1-365.
CALENDAR_LOOKAHEAD_DAYS=30

# --- notification_send ---------------------------------------------------
# Comma-separated exact addresses. EMPTY MEANS THE TOOL IS DISABLED, which is
# the default. There is no wildcard: gmail_read puts text written by arbitrary
# senders into the model's context, and this tool sends mail as you.
NOTIFICATION_ALLOWED_RECIPIENTS=
